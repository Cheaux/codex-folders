{
  "name": "codex-folders",
  "version": "0.1.1",
  "description": "Organize Codex CLI conversations into folders with an in-terminal chat browser and shared project memory.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "codex-folders": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugins",
    ".agents",
    "README.md",
    "LICENSE",
    "terminal-extension.json",
    "runtime"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs",
    "test:pty": "python3 test/browser_pty.py && python3 test/launcher_pty.py",
    "demo": "node --import tsx scripts/render-demo.ts",
    "package:directory": "python3 scripts/package-directory.py"
  },
  "dependencies": {
    "@inquirer/core": "12.0.4",
    "@inquirer/prompts": "8.7.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "string-width": "^8.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "@xterm/headless": "^6.0.0"
  },
  "author": "Cheaux",
  "homepage": "https://cheaux.github.io/codex-folders/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cheaux/codex-folders.git"
  },
  "bugs": {
    "url": "https://github.com/Cheaux/codex-folders/issues"
  },
  "keywords": [
    "codex",
    "codex-cli",
    "codex-plugin",
    "chat-folders",
    "conversation-manager",
    "project-memory",
    "shared-context",
    "mcp",
    "terminal",
    "openai"
  ]
}
